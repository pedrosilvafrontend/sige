{
  "name": "sige",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:8080": "cross-env BACKEND_URL=http://localhost:8080 ng serve",
    "start:local": "cross-env BACKEND_URL=http://localhost:8081 ng serve --host 0.0.0.0 --port 4200",
    "start:local:ssl": "cross-env BACKEND_URL=http://localhost:8081 http-server dist/sige/browser -p 4200 -S -C .cert/localhost.crt -K .cert/localhost.key --proxy http://localhost:8081?",
    "version:generate": "./scripts/generate-version-json.sh",
    "build": "npm run version:generate && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.5.1",
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/cdk": "~22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "~22.0.2",
    "@angular/material-date-fns-adapter": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@fullcalendar/angular": "^6.1.21",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "angular-gridster2": "^22.0.0",
    "base64-js": "^1.5.1",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.4.0",
    "ng2-charts": "^8.0.0",
    "ngx-editor": "^19.0.0-beta.1",
    "ngx-mask": "^21.0.1",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
